set number
set relativenumber
set signcolumn=yes
set fileformats=unix,dos
set wrap
set tabstop=2
set shiftwidth=0
set softtabstop=-1
set noswapfile
set nobackup
set nowritebackup
set scrolloff=5
set whichwrap+=h,l,<,>,[,]
set spelllang=en,cjk
set list
set listchars=tab:»\ ,trail:·,lead:·,nbsp:␣

" Machine-local overrides.
silent! source ~/.vimrc.local
