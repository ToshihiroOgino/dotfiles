#!/usr/bin/env bash
self=$(realpath "$0")
for real in $(type -ap magick); do
	[ "$(realpath "$real")" != "$self" ] && break
done

if [ "$1" = identify ] || ! command -v rsvg-convert >/dev/null; then
	exec "$real" "$@"
fi

tmp=$(mktemp --suffix=.png)
trap 'rm -f "$tmp"' EXIT
args=()
for a in "$@"; do
	if [[ $a =~ ^(.*\.svg)(\[[0-9]+\])?$ ]] && [ -f "${BASH_REMATCH[1]}" ]; then
		rsvg-convert -z 2 -b white -o "$tmp" "${BASH_REMATCH[1]}" && a=$tmp
	fi
	args+=("$a")
done
"$real" "${args[@]}"
