# Shows pending package changes in the prompt. Needs `make pkgsync`.
_pkgsync_zsh="${PKGSYNC_ROOT:-$HOME/dotfiles}/tools/pkgsync/pkgsync.zsh"
[[ -r $_pkgsync_zsh ]] && source "$_pkgsync_zsh"

# Completions for the tools in this repo; must be on fpath before compinit runs.
fpath=("${${(%):-%x}:A:h}/completions" $fpath)

ZSH_THEME="eastwood"
DISABLE_UNTRACKED_FILES_DIRTY="true"
HIST_STAMPS="yyyy/mm/dd"
plugins=(git)

if [[ -e "$HOME/.oh-my-zsh" ]]; then
  export ZSH="$HOME/.oh-my-zsh"
  zstyle ':omz:update' mode auto
  source $ZSH/oh-my-zsh.sh
fi

# Put the input line below the info line.
PROMPT='$(git_custom_status)%{$fg[cyan]%}[%~% ]%{$reset_color%}
%B$%b '

export PATH="$HOME/.local/bin:$HOME/go/bin:$PATH"

alias bat=batcat
alias rm=trash
alias nvim='NVIM_APPNAME=nvim-tshr nvim'
alias lvim='NVIM_APPNAME=nvim command nvim'
alias v=nvim

export CMAKE_GENERATOR=Ninja
export BAT_PAGER="less -RF --mouse"

[[ -r ~/.local.zshrc ]] && source ~/.local.zshrc
